# MultiMind deployment environment template.
#
# Copy values into the production environment or an untracked server-side .env
# file. Never commit real credentials. The .env and .secrets paths are ignored
# by Git and Docker build context.

# Host port bindings. Keep defaults unless the production host needs different
# published ports.
MULTIMIND_FRONTEND_PORT=3000
MULTIMIND_BACKEND_PORT=8000

# Replace the reserved .invalid examples with the real browser-visible origins
# before production. Do not use localhost or wildcard CORS for an internet-
# facing deployment.
MULTIMIND_DEPLOY_URL=https://multimind.example.invalid
MULTIMIND_API_URL=https://api.multimind.example.invalid
MULTIMIND_CORS_ALLOWED_ORIGINS=https://multimind.example.invalid

# Persistence. When BOTH Turso values are configured, MultiMind uses the remote
# database as authoritative user-scoped persistence. If both are blank, the
# existing SQLite path remains the fallback/rollback implementation. Supplying
# only one Turso value fails closed instead of silently using local SQLite.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Durable Docker volume name for deployments that intentionally use SQLite.
# Do not delete this volume during routine deploy or rollback.
MULTIMIND_DATA_VOLUME=multimind-data

# Operator/default provider credentials. These remain useful for deployment
# smoke/proof tooling. Strict deployment secret resolution does NOT expose this
# pool through a browser login, including a user who types `default`.
MULTIMIND_GEMINI_KEY=
MULTIMIND_DEEPSEEK_KEY=
MULTIMIND_GROQ_KEY=
MULTIMIND_CLOUDFLARE_KEY=
MULTIMIND_CLOUDFLARE_ACCOUNT_ID=
MULTIMIND_OPENROUTER_KEY=
MULTIMIND_HUGGINGFACE_KEY=
MULTIMIND_REMOTE_URL=

# Per-user provider resource pools.
# Slot labels (A, B, TEACHER1, etc.) are deployment-only labels; *_ID is the
# validated MultiMind user id used at login/runtime. Add only the providers that
# user actually owns. Numbered resources (_2, _3, ...) are explicit same-provider
# resources and are NOT automatically rotated on rate limits or failures.
#
# Optional *_PRIMARY_RESOURCE selectors choose one configured resource explicitly.
# Values are `primary`/`1` or a numbered resource such as `2`. If an explicitly
# selected resource is absent/incomplete, that provider fails closed instead of
# silently selecting another credential.
#
# Example only; keep values blank in source.
MULTIMIND_USER_A_ID=
MULTIMIND_USER_A_GEMINI_KEY=
MULTIMIND_USER_A_GEMINI_KEY_2=
MULTIMIND_USER_A_GEMINI_PRIMARY_RESOURCE=
MULTIMIND_USER_A_GROQ_KEY=
MULTIMIND_USER_A_GROQ_KEY_2=
MULTIMIND_USER_A_GROQ_PRIMARY_RESOURCE=
MULTIMIND_USER_A_CLOUDFLARE_KEY=
MULTIMIND_USER_A_CLOUDFLARE_ACCOUNT_ID=
MULTIMIND_USER_A_CLOUDFLARE_KEY_2=
MULTIMIND_USER_A_CLOUDFLARE_ACCOUNT_ID_2=
MULTIMIND_USER_A_CLOUDFLARE_PRIMARY_RESOURCE=
MULTIMIND_USER_A_OPENROUTER_KEY=
MULTIMIND_USER_A_OPENROUTER_KEY_2=
MULTIMIND_USER_A_OPENROUTER_PRIMARY_RESOURCE=
MULTIMIND_USER_A_HUGGINGFACE_KEY=
MULTIMIND_USER_A_DEEPSEEK_KEY=
MULTIMIND_USER_A_REMOTE_URL=

MULTIMIND_USER_B_ID=
MULTIMIND_USER_B_GEMINI_KEY=
MULTIMIND_USER_B_GROQ_KEY=
MULTIMIND_USER_B_OPENROUTER_KEY=

# Optional private Design-DNA BuildKit secret file. The package is not required
# for neutral MultiMind operation.
MULTIMIND_GITHUB_TOKEN_FILE=./.secrets/github_token
