# MultiMind deployment environment template.
# Copy values into production/untracked server-side env. Never commit credentials.
MULTIMIND_FRONTEND_PORT=3000
MULTIMIND_BACKEND_PORT=8000
MULTIMIND_DEPLOY_URL=https://multimind.example.invalid
MULTIMIND_API_URL=https://api.multimind.example.invalid
MULTIMIND_CORS_ALLOWED_ORIGINS=https://multimind.example.invalid
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
MULTIMIND_DATA_VOLUME=multimind-data

# Built-in deployment/operator provider pool.
MULTIMIND_GEMINI_KEY=
MULTIMIND_DEEPSEEK_KEY=
MULTIMIND_GROQ_KEY=
MULTIMIND_CLOUDFLARE_KEY=
MULTIMIND_CLOUDFLARE_ACCOUNT_ID=
MULTIMIND_OPENROUTER_KEY=
MULTIMIND_HUGGINGFACE_KEY=
MULTIMIND_REMOTE_URL=

# Optional generic OpenAI-compatible resources, server-side only. Each resource
# is probed through its model catalogue; recognizable model IDs become truthful
# AI-family routes (Claude/GPT/Qwen/etc). A catalogue declaration is recorded as
# provider-declared provenance, not cryptographic proof of the upstream model.
# Example shape (DO NOT commit a real key):
# [{"id":"kios-a","label":"Kios A","base_url":"https://api.example.invalid/v1","key":"REPLACE_SERVER_SIDE"}]
MULTIMIND_OPENAI_COMPATIBLE_RESOURCES_JSON=

# Canonical per-user provider resource pools. Keep this as a server-side secret.
# JSON shape is documented in docs/governance/PER_USER_PROVIDER_RESOURCE_POOLS.md.
MULTIMIND_USER_PROVIDER_POOLS_JSON=
MULTIMIND_ALLOW_DEFAULT_CREDENTIALS_FOR_USERS=

# Optional private Design-DNA BuildKit secret file.
MULTIMIND_GITHUB_TOKEN_FILE=./.secrets/github_token
