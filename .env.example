# MultiMind deployment environment template.
#
# Copy values into the production environment or an untracked server-side .env
# file. Never commit real credentials. The .env and .secrets paths are ignored
# by Git and Docker build context.

# Host port bindings. Keep defaults unless the production host needs different
# published ports.
MULTIMIND_FRONTEND_PORT=3000
MULTIMIND_BACKEND_PORT=8000

# Replace the reserved .invalid examples with the real browser-visible origins
# before production. Do not use localhost or wildcard CORS for an internet-
# facing deployment.
MULTIMIND_DEPLOY_URL=https://multimind.example.invalid
MULTIMIND_API_URL=https://api.multimind.example.invalid
MULTIMIND_CORS_ALLOWED_ORIGINS=https://multimind.example.invalid

# Persistence. When BOTH Turso values are configured, MultiMind uses the remote
# database as authoritative user-scoped persistence. If both are blank, the
# existing SQLite path remains the fallback/rollback implementation. Supplying
# only one Turso value fails closed instead of silently using local SQLite.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Durable Docker volume name for deployments that intentionally use SQLite.
# Do not delete this volume during routine deploy or rollback.
MULTIMIND_DATA_VOLUME=multimind-data

# Deployment/operator provider pool. These remain useful for explicit operator
# smoke/proof paths. Authenticated Reflex users do NOT inherit this pool unless
# MULTIMIND_ALLOW_DEFAULT_CREDENTIALS_FOR_USERS is explicitly enabled.
MULTIMIND_GEMINI_KEY=
MULTIMIND_DEEPSEEK_KEY=
MULTIMIND_GROQ_KEY=
MULTIMIND_CLOUDFLARE_KEY=
MULTIMIND_CLOUDFLARE_ACCOUNT_ID=
MULTIMIND_OPENROUTER_KEY=
MULTIMIND_HUGGINGFACE_KEY=
MULTIMIND_REMOTE_URL=

# Canonical per-user provider resource pools. Keep this as a server-side secret.
# JSON shape is documented in docs/governance/PER_USER_PROVIDER_RESOURCE_POOLS.md.
# Multiple named resources may exist for one provider, but only the explicitly
# declared default resource is used; MultiMind does not auto-rotate keys.
MULTIMIND_USER_PROVIDER_POOLS_JSON=

# Default is fail-closed for authenticated users. Enable only if the operator
# intentionally wants users without a personal pool to consume the deployment
# default provider pool.
MULTIMIND_ALLOW_DEFAULT_CREDENTIALS_FOR_USERS=false

# Optional private Design-DNA BuildKit secret file. The package is not required
# for neutral MultiMind operation.
MULTIMIND_GITHUB_TOKEN_FILE=./.secrets/github_token
